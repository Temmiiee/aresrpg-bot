{
  "name": "@aresrpg/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless automation bot for a real AresRPG party (zkLogin) — auto-fight, spell-aware, on Sui testnet.",
  "scripts": {
    "enoki-login": "bun run src/cli_enoki_login.ts",
    "group-fight": "bun run src/cli_group_fight_loop.ts",
    "session": "bun run src/cli_group_session.ts",
    "session-stats": "bun run src/cli_session_stats.ts",
    "dashboard": "bun run src/cli_dashboard.ts",
    "control-panel": "bun run src/cli_control_panel.ts",
    "faucet-check": "bun run src/cli_faucet_check.ts",
    "auto-sell": "bun run src/cli_auto_sell.ts",
    "characters": "bun run src/cli_character_report.ts",
    "tune": "bun run src/cli_tune.ts",
    "train": "bun run src/cli_train.ts",
    "record-replay": "bun run src/cli_record_replay.ts",
    "compositions": "bun run src/cli_compositions.ts",
    "validate-policy": "bun run src/cli_validate_policy.ts",
    "simulate-session": "bun run src/cli_simulate_session.ts",
    "build-standalone": "bun run scripts/build_standalone.mjs",
    "reset-character": "bun run src/cli_reset_character.ts"
  },
  "dependencies": {
    "@aresrpg/fight": "workspace:*",
    "@aresrpg/immutable": "workspace:*",
    "@aresrpg/sdk": "workspace:*",
    "@mysten/enoki": "1.2.12",
    "@mysten/kiosk": "1.4.4",
    "@mysten/sui": "2.26.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~6.0.3"
  }
}
